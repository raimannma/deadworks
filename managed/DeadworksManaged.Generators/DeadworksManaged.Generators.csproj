<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin to the .NET 10 RTM Roslyn (5.0.0) — the floor across our supported SDKs.
         A generator built against a compiler NEWER than the host's Roslyn fails to
         load (CS9057) and silently emits nothing, breaking every plugin that uses a
         generated [GameEventHandler] arg type. Targeting the floor loads in both the
         local SDK and the (newer) Docker SDK; older-targeted analyzers always load in
         newer hosts. CodeAnalysis.Analyzers is analyzer-authoring rules only and does
         not affect the compiler-version gate. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
